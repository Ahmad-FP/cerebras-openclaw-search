{
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace",
      "model": {
        "primary": "cerebras/moonshotai-kimi-k3.1-pro-trial"
      },
      "thinkingDefault": "low",
      "heartbeat": {
        "every": "0m"
      },
      "contextInjection": "never"
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "cerebras": {
        "baseUrl": "https://api.cerebras.ai/v1",
        "api": "openai-completions",
        "apiKey": "${CEREBRAS_API_KEY}",
        "models": [
          {
            "id": "moonshotai-kimi-k3.1-pro-trial",
            "name": "Kimi K3.1 Pro (Cerebras)",
            "reasoning": true,
            "input": [
              "text",
              "image"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "compat": {
              "supportsTools": true,
              "supportsStrictMode": false,
              "supportsReasoningEffort": true,
              "supportedReasoningEfforts": [
                "low",
                "high",
                "max"
              ]
            }
          }
        ]
      }
    }
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token"
    },
    "bind": "loopback",
    "tailscale": {
      "mode": "off"
    }
  },
  "tools": {
    "profile": "minimal",
    "web": {
      "fetch": {
        "ssrfPolicy": {
          "allowRfc2544BenchmarkRange": true,
          "allowIpv6UniqueLocalRange": true
        }
      }
    },
    "toolSearch": false,
    "alsoAllow": [
      "gifts__*"
    ]
  },
  "browser": {
    "enabled": true,
    "ssrfPolicy": {
      "allowRfc2544BenchmarkRange": true,
      "allowIpv6UniqueLocalRange": true
    }
  },
  "plugins": {
    "entries": {
      "cerebras": {
        "enabled": true
      },
      "browser": {
        "enabled": true
      }
    }
  },
  "skills": {
    "workshop": {
      "autonomous": {
        "mode": "off"
      }
    },
    "allowBundled": []
  },
  "mcp": {
    "servers": {
      "gifts": {
        "command": "node",
        "args": [
          "/path/to/cerebras-openclaw-search/gift-search-mcp.mjs"
        ],
        "env": {},
        "supportsParallelToolCalls": true,
        "connectionTimeoutMs": 60000,
        "requestTimeoutMs": 60000
      }
    }
  }
}